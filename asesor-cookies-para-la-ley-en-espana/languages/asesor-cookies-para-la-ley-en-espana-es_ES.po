msgstr ""
"Permite el seguimiento de conversiones y la medición publicitaria de "
"Pinterest."

#: lib/plugin.php:2797
msgid ""
"Supports embedded timelines, social interaction, and advertising "
"personalization."
msgstr ""
"Permite timelines embebidos, interacción social y personalización "
"publicitaria."

